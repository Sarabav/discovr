# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed.

# Secret key Flask uses to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Path to the SQLite database file (relative to the project root).
DATABASE_PATH=data/app.db

# Local dev server settings.
PORT=8014
FLASK_DEBUG=true

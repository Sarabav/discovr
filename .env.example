# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed.

# Secret key Flask uses to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Path to the SQLite database file (relative to the project root).
DATABASE_PATH=data/app.db

# Local dev server settings.
PORT=8014
FLASK_DEBUG=true

# OpenRouter API key, used by src/agents.py. Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=changeme

# Any OpenRouter model id. See https://openrouter.ai/models for current
# free-tier availability — free model slugs get deprecated and removed
# without much notice, so if structured-output calls start failing,
# check the model id here still resolves before suspecting the code.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Any OpenRouter embedding model id, used by src.agents.embed (RAG:
# src/rag.py). Runs through the same API key as chat calls above —
# no local embedding model, so nothing like sentence-transformers/torch
# loads into this process. Optional; defaults to openai/text-embedding-3-small.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Supabase project, used only when the admin page's Data Source dropdown
# is switched to "Supabase" (see src/store.py). SUPABASE_API_KEY should
# be the service-role key, not the anon key, since the app writes as a
# trusted backend and RLS would otherwise block it. Optional — the app
# runs fully on local SQLite without these.
SUPABASE_URL=changeme
SUPABASE_API_KEY=changeme

# Direct Postgres connection (Settings -> Database -> Connection string
# -> session pooler, in the Supabase dashboard). Needed only for the
# "Clone Local Data to Supabase" button's table creation — the REST API
# above (SUPABASE_URL/SUPABASE_API_KEY) can only read/write rows in
# tables that already exist, not run CREATE TABLE.
SUPABASE_DB_URL=changeme

# Stripe secret key, used by src/billing.py for the $5 one-time chatbot
# paywall (Checkout Sessions + refunds). Get a test key at
# https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=changeme
